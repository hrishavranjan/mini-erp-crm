# ==== Server ====
PORT=5000
NODE_ENV=development

# ==== Supabase ====
# Get these from Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the SERVICE ROLE key on the backend only (never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==== JWT ====
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# ==== CORS ====
# Comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

# ==== Seed script (used only by `npm run seed`) ====
SEED_ADMIN_EMAIL=admin@erp.com
SEED_ADMIN_PASSWORD=Password@123
SEED_SALES_EMAIL=sales@erp.com
SEED_SALES_PASSWORD=Password@123
SEED_WAREHOUSE_EMAIL=warehouse@erp.com
SEED_WAREHOUSE_PASSWORD=Password@123
SEED_ACCOUNTS_EMAIL=accounts@erp.com
SEED_ACCOUNTS_PASSWORD=Password@123
